{
  "plugins": ["react", "typescript", "oxc", "eslint", "import", "node"],
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "@tanstack/router/create-route-property-order": "error",
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "vendor/**",
    "test/snapshots/**",
    "**/routeTree.gen.ts"
  ],
  "options": {
    "typeAware": true
  }
}
